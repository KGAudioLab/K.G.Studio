{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "npm: dev",
            "detail": "vite",
            "isBackground": true,
            "command": "source ~/.nvm/nvm.sh && nvm use && npm run dev",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/zsh",
                    "args": [
                        "-c"
                    ]
                }
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "ready in .*ms"
                }
            }
        },
        {
            "type": "shell",
            "label": "npm: dev (Windows)",
            "detail": "vite",
            "isBackground": true,
            "command": "npm run dev",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "ready in .*ms"
                }
            }
        },
        {
            "type": "shell",
            "label": "npm: dev:mcp (macOS)",
            "detail": "Vite development server with local MCP (browser tab required)",
            "isBackground": true,
            "command": "source ~/.nvm/nvm.sh && nvm use && npm run dev:mcp",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/zsh",
                    "args": [
                        "-c"
                    ]
                }
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "ready in .*ms"
                }
            }
        },
        {
            "type": "shell",
            "label": "npm: dev:mcp (Windows)",
            "detail": "Vite development server with local MCP (browser tab required)",
            "isBackground": true,
            "command": "npm run dev:mcp",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                },
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "ready in .*ms"
                }
            }
        }
    ]
}
